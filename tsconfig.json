{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2022",
    "lib": ["dom", "dom.iterable", "es2015"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true
  },
  "include": [
      "./src",
      "./test"
  ]
}
